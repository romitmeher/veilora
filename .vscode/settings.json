{
  "editor.formatOnSave": true,
  "dotnet.server.useOmnisharp": false,
  "dotnet.autoInsertUsingLocations": false,
  "dotnet.projects.enableAutomaticRestore": false,
  "dotnet.projects.enableAutomaticSolutionGeneration": false,
  "dotnet.enableDefaultWorkspaceSolutionLoading": false,
  "dotnet.defaultSolution": "disable",
  "files.exclude": {
    "third_party": true
  },
  "search.exclude": {
    "third_party": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "dotnet.preferCSharpExtension": true
}